<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/pceinotifications/db" VERSION="2026071806" COMMENT="PCEI - Notificaciones ATPA/TEI">
  <TABLES>
    <TABLE NAME="local_pceinotif_blocks" COMMENT="Bloques ATPA/TEI sincronizados desde secciones">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="sectionid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="sectionname" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="blocktype" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="other"/>
        <FIELD NAME="sequenceindex" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="startdate" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="enddate" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="bbbcmid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="blockstate" TYPE="char" LENGTH="30" NOTNULL="true" DEFAULT="detected"/>
        <FIELD NAME="syncsource" TYPE="char" LENGTH="30" NOTNULL="false"/>
        <FIELD NAME="syncnote" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="lastsync" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="calendarstatus" TYPE="char" LENGTH="30" NOTNULL="true" DEFAULT="pending"/>
        <FIELD NAME="calendarnote" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="calendarupdated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_course_section" UNIQUE="true" FIELDS="courseid,sectionid"/>
        <INDEX NAME="idx_course_type_date" UNIQUE="false" FIELDS="courseid,blocktype,startdate"/>
      </INDEXES>
    </TABLE>

    <TABLE NAME="local_pceinotif_log" COMMENT="Bitácora de notificaciones enviadas">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="blockid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="notiftype" TYPE="char" LENGTH="30" NOTNULL="true"/>
        <FIELD NAME="subject" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="messagehash" TYPE="char" LENGTH="40" NOTNULL="false"/>
        <FIELD NAME="success" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="errormsg" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timesent" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_unique_send" UNIQUE="true" FIELDS="courseid,blockid,userid,notiftype"/>
        <INDEX NAME="idx_course_user" UNIQUE="false" FIELDS="courseid,userid"/>
      </INDEXES>
    </TABLE>
  
    <TABLE NAME="local_pceinotif_events" COMMENT="Calendar synchronization for VNotificator blocks">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="blockid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="eventid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="eventtype" TYPE="char" LENGTH="30" NOTNULL="true" DEFAULT="course"/>
        <FIELD NAME="status" TYPE="char" LENGTH="30" NOTNULL="true" DEFAULT="created"/>
        <FIELD NAME="errormsg" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="uq_blockid" UNIQUE="true" FIELDS="blockid"/>
        <INDEX NAME="idx_courseid" UNIQUE="false" FIELDS="courseid"/>
        <INDEX NAME="idx_eventid" UNIQUE="false" FIELDS="eventid"/>
      </INDEXES>
    </TABLE>

